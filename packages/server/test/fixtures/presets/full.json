    {
      "identifier": "3f1c2a7e-0001-4000-8000-000000000004",
      "name": "Disabled extra",
      "system_prompt": false,
      "role": "system",
      "content": "Unused."
    }
  ],
  "prompt_order": [
    {
      "character_id": 100001,
      "order": [
        { "identifier": "main", "enabled": true },
        { "identifier": "3f1c2a7e-0001-4000-8000-000000000001", "enabled": true },
        { "identifier": "worldInfoBefore", "enabled": true },
        { "identifier": "personaDescription", "enabled": false },
        { "identifier": "charDescription", "enabled": true },
        { "identifier": "charPersonality", "enabled": true },
        { "identifier": "scenario", "enabled": true },
        { "identifier": "enhanceDefinitions", "enabled": false },
        { "identifier": "nsfw", "enabled": true },
        { "identifier": "worldInfoAfter", "enabled": true },
        { "identifier": "dialogueExamples", "enabled": true },
        { "identifier": "chatHistory", "enabled": true },
        { "identifier": "3f1c2a7e-0001-4000-8000-000000000002", "enabled": true },
        { "identifier": "3f1c2a7e-0001-4000-8000-000000000003", "enabled": true },
        { "identifier": "3f1c2a7e-0001-4000-8000-000000000004", "enabled": false },
        { "identifier": "jailbreak", "enabled": true }
      ]
    },
    {
      "character_id": 7,
      "order": [{ "identifier": "main", "enabled": true }]
    }
  ],
  "extensions": {
    "regex_scripts": [
      {
        "id": "8a2d6c1e-0002-4000-8000-000000000001",
        "scriptName": "Strip thinking from the prompt",
        "findRegex": "/<thinking>[\\s\\S]*?<\\/thinking>/g",
        "replaceString": "",
        "trimStrings": [],
        "placement": [2],
        "disabled": false,
        "markdownOnly": false,
        "promptOnly": true,
        "runOnEdit": true,
        "substituteRegex": 0,
        "minDepth": null,
        "maxDepth": 3
      },
      {
        "id": "8a2d6c1e-0002-4000-8000-000000000002",
        "scriptName": "Italicize {{char}}'s name",
        "findRegex": "/{{char}}/g",
        "replaceString": "*$&*",
        "trimStrings": ["  "],
        "placement": [1, 2],
        "disabled": true,
        "markdownOnly": true,
        "promptOnly": false,
        "runOnEdit": false,
        "substituteRegex": 2,
        "minDepth": 1,
        "maxDepth": null
      },
      {
        "id": "8a2d6c1e-0002-4000-8000-000000000003",
        "scriptName": "Normalize ellipses",
        "findRegex": "/\\.{3}/g",
        "replaceString": "…",
        "trimStrings": [],
        "placement": [2],
        "disabled": false,
        "markdownOnly": false,
        "promptOnly": false,
        "runOnEdit": true,
        "substituteRegex": 1,
        "minDepth": -1,
        "maxDepth": -5
      }
    ],
    "example_extension": { "setting": true }
  }
