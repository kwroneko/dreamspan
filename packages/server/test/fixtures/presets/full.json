      "role": "user",
      "content": "Write in the present tense.",
      "injection_position": 0,
      "injection_depth": 4,
      "forbid_overrides": false,
      "injection_trigger": []
    },
    {
      "identifier": "3f1c2a7e-0001-4000-8000-000000000002",
      "name": "Tail reminder",
      "system_prompt": false,
      "role": "system",
      "content": "[Reminder: keep replies under 300 words.]",
      "injection_position": 1,
      "injection_depth": 0,
      "injection_order": 50,
      "injection_trigger": ["normal", "swipe", "regenerate"]
