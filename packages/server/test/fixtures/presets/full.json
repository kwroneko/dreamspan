{
  "chat_completion_source": "custom",
  "custom_model": "example-local-model",
  "custom_url": "http://192.0.2.10:5000/v1",
  "custom_include_headers": "X-Example: secret-header-value",
  "reverse_proxy": "https://proxy.example.invalid/v1",
  "proxy_password": "example-proxy-password",
  "temperature": "0.85",
  "frequency_penalty": 0.1,
  "presence_penalty": 0.2,
  "top_p": 0.95,
  "top_k": 40,
  "top_a": 0.1,
  "min_p": 0.05,
  "repetition_penalty": 1.1,
  "openai_max_context": 32000,
  "openai_max_tokens": 800,
  "max_context_unlocked": true,
  "seed": 1234,
  "n": 2,
  "reasoning_effort": "high",
  "verbosity": "low",
  "names_behavior": 2,
  "send_if_empty": "[{{user}} waits.]",
  "impersonation_prompt": "[Write as {{user}}.]",
  "new_chat_prompt": "[Begin]",
  "new_group_chat_prompt": "[Begin with {{group}}]",
  "new_example_chat_prompt": "[Example]",
  "continue_nudge_prompt": "[Continue.]",
  "group_nudge_prompt": "[As {{char}} only.]",
  "wi_format": "<lore>\n{0}\n</lore>",
  "scenario_format": "Scenario: {{scenario}}",
  "personality_format": "Personality: {{personality}}",
  "custom_prompt_post_processing": "strict",
  "squash_system_messages": true,
  "use_sysprompt": true,
  "assistant_prefill": "<thinking>",
  "assistant_impersonation": "{{user}}:",
  "continue_prefill": true,
  "continue_postfix": "\n",
  "stream_openai": true,
  "function_calling": true,
  "media_inlining": true,
  "bias_preset_selected": "Default (none)",
  "example_unknown_field": { "kept": [1, 2, 3] },
  "prompts": [
    {
      "identifier": "main",
      "name": "Main Prompt",
      "system_prompt": true,
      "role": "system",
      "content": "You are the narrator of an interactive story.",
      "forbid_overrides": true
    },
    { "identifier": "nsfw", "name": "Auxiliary Prompt", "system_prompt": true, "role": "system", "content": "" },
    { "identifier": "dialogueExamples", "name": "Chat Examples", "system_prompt": true, "marker": true },
    {
      "identifier": "jailbreak",
      "name": "Post-History Instructions",
      "system_prompt": true,
      "role": "system",
      "content": "Stay in the scene."
    },
    { "identifier": "chatHistory", "name": "Chat History", "system_prompt": true, "marker": true },
    { "identifier": "worldInfoAfter", "name": "World Info (after)", "system_prompt": true, "marker": true },
    { "identifier": "worldInfoBefore", "name": "World Info (before)", "system_prompt": true, "marker": true },
    {
      "identifier": "enhanceDefinitions",
      "name": "Enhance Definitions",
      "system_prompt": true,
      "role": "system",
      "content": "Fill gaps in the sheet.",
      "marker": false
    },
    {
      "identifier": "charDescription",
      "name": "Char Description",
      "system_prompt": true,
      "marker": true,
      "role": "user"
    },
    { "identifier": "charPersonality", "name": "Char Personality", "system_prompt": true, "marker": true },
    { "identifier": "scenario", "name": "Scenario", "system_prompt": true, "marker": true },
    { "identifier": "personaDescription", "name": "Persona Description", "system_prompt": true, "marker": true },
    {
      "identifier": "3f1c2a7e-0001-4000-8000-000000000001",
