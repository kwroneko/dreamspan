# AppArmor profile for the Dreamspan container (docker/README.md, "AppArmor").
#
# Docker's own `docker-default` (moby/profiles, apparmor/template.go, as Docker 29 generates
# it), with one change: `deny mount` is replaced by what bubblewrap needs to build each
# command's sandbox inside its own user namespace (mount, remount, umount, pivot_root) and the
# entrypoint needs for the commands' cgroup view (a cgroup2 mount). Everything else is
# docker-default: the /proc and /sys write denials, no access to /sys/firmware,
# /sys/kernel/security, kcore or sysrq-trigger, signals only within the profile.
#
# The kernel still checks every mount against the namespace's own capabilities: outside a user
# namespace the server, without CAP_SYS_ADMIN, can't mount anything.
#
# Load on the Docker host:  sudo apparmor_parser -r -W docker/apparmor-dreamspan
# Use in compose:           security_opt: ["apparmor=dreamspan", ...]
#
# `userns,` is for AppArmor 4 (Ubuntu 23.10 and later restrict unprivileged user namespaces
# to profiles that allow them). AppArmor 3 parsers (Debian 12) don't know the rule: delete
# that line there.

#include <tunables/global>

profile dreamspan flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>

  network,
  capability,
  file,
  umount,
  # Host (privileged) processes may send signals to container processes.
  signal (receive) peer=unconfined,
  # runc and crun may send signals to container processes (for "docker stop").
  signal (receive) peer=runc,
  signal (receive) peer=crun,
  # dockerd may send signals to container processes (for "docker kill").
  signal (receive) peer=dockerd,
  # Container processes may send signals amongst themselves.
  signal (send,receive) peer=dreamspan,

  # What docker-default denies and bubblewrap needs: its sandbox's mounts and root switch.
  mount,
  remount,
  pivot_root,
  userns,

  deny @{PROC}/* w,   # deny write for all files directly in /proc (not in a subdir)
  # deny write to files not in /proc/<number>/** or /proc/sys/**
  deny @{PROC}/{[^1-9],[^1-9][^0-9],[^1-9s][^0-9y][^0-9s],[^1-9][^0-9][^0-9][^0-9/]*}/** w,
  deny @{PROC}/sys/[^k]** w,  # deny /proc/sys except /proc/sys/k* (effectively /proc/sys/kernel)
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,  # deny everything except shm* in /proc/sys/kernel/
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,

  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/devices/virtual/powercap/** rwklx,
  deny /sys/kernel/security/** rwklx,

  # suppress ptrace denials when using 'docker ps' or using 'ps' inside a container
  ptrace (trace,read,tracedby,readby) peer=dreamspan,
}
