{
  "name": "rp-harness",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24.11"
  },
  "scripts": {
    "dev:server": "node --watch packages/server/src/main.ts",
    "dev:client": "npm run dev -w @rp/client",
    "build": "npm run build -w @rp/client && npm run build -w @rp/server",
    "start": "node packages/server/src/main.ts",
    "typecheck": "tsc --noEmit -p packages/shared && tsc --noEmit -p packages/server && tsc --noEmit -p packages/client",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip --no-progress",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run knip && npm run test"
  },
  "devDependencies": {
    "@effect/language-service": "0.87.3",
    "@effect/vitest": "4.0.1",
    "@types/node": "24.19.1",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "knip": "6.39.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
