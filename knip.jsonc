{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  // The shared package's package.json exports every file, which would make all of its
  // exports public API. Only our own packages import it, so an export nobody uses is dead.
  "includeEntryExports": true,
  // Host diagnostics for the opt-in paired performance benchmark; supplied by the OS.
  "ignoreBinaries": ["uptime"],
  // The panel frames' vendored libraries (spec/HTML-MESSAGES.md §3.3): copied from node_modules into
  // the build by vite.config.ts `frameLibraries`, never imported.
  "ignoreDependencies": [
    "@fortawesome/fontawesome-free",
    "@tailwindcss/browser",
    "jquery",
    "jquery-ui",
    "jquery-ui-touch-punch",
    "lodash",
    "vue",
    "vue-router"
  ],
  "workspaces": {
    ".": {
      // Throwaway experiments, kept for their findings and not part of the build.
      "project": ["**/*.{js,ts,tsx}", "!spikes/**"]
    }
  }
}
